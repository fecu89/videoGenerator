  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "visual_sequences": {
            "maxItems": 0
          },
          "visual_beats": {
            "maxItems": 0
          },
          "scenes": {
            "items": {
              "required": [
                "shots"
              ],
              "properties": {
                "shots": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "visual_sequences",
          "visual_beats"
        ],
        "properties": {
          "visual_sequences": {
            "minItems": 1
          },
          "visual_beats": {
            "minItems": 1
          }
        }
      }
    }
  ]
