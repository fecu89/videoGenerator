{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-generator/script.schema.json",
  "title": "Video Generator Script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates",
    "selected_topic",
    "story_engine",
    "scenes",
    "fact_checks",
    "sources"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/topicCandidate" }
    },
    "selected_topic": { "$ref": "#/$defs/selectedTopic" },
    "story_engine": { "$ref": "#/$defs/storyEngine" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "fact_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/factCheck" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "response_id": { "type": ["string", "null"] }
  },
  "$defs": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surprise", "visualizability", "causal_clarity", "evidence_quality"],
      "properties": {
        "surprise": { "type": "integer", "minimum": 1, "maximum": 5 },
        "visualizability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "causal_clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "evidence_quality": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "topicCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "premise", "scores", "source_ids"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "premise": { "type": "string", "minLength": 1 },
        "scores": { "$ref": "#/$defs/scores" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "selectedTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "reason"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "storyEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_belief", "contradiction", "obvious_answer", "constraint", "actual_answer", "mechanism", "payoff"],
      "properties": {
        "common_belief": { "type": "string", "minLength": 1 },
        "contradiction": { "type": "string", "minLength": 1 },
        "obvious_answer": { "type": "string", "minLength": 1 },
        "constraint": { "type": "string", "minLength": 1 },
        "actual_answer": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "payoff": { "type": "string", "minLength": 1 }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "title", "narration", "narrative_role", "visual_subject", "source_ids", "duration_seconds", "audio_file", "video_prompt_file"],
      "properties": {
        "scene_id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "narration": { "type": "string", "minLength": 1 },
        "narrative_role": { "type": "string", "minLength": 1 },
        "visual_subject": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "duration_seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "audio_file": { "type": ["string", "null"] },
        "video_prompt_file": { "type": ["string", "null"] },
        "sentence_pauses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sentence_index",
              "after",
              "kind"
            ],
            "properties": {
              "sentence_index": {
                "type": "integer",
                "minimum": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "semantic",
                  "emphasis"
                ]
              }
            }
          }
        },
        "sentence_delivery": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/sentenceDelivery" }
        }
      }
    },
    "sentenceDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence_index", "emotion"],
      "properties": {
        "sentence_index": { "type": "integer", "minimum": 1 },
        "emotion": {
          "enum": [
            "neutral",
            "curious",
            "bright",
            "surprised",
            "confident",
            "gentle"
          ]
        },
        "intensity": {
          "enum": ["subtle", "moderate"],
          "default": "subtle"
        }
      }
    },
    "factCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "check_type", "question"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "check_type": { "enum": ["NUM", "CAUSE", "HISTORY", "TECH", "SUPER", "OTHER"] },
        "question": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "url", "summary", "source_type", "page"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "summary": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["web", "pdf"] },
        "page": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
