        "shot_id",
        "title",
        "duration_seconds",
        "render_mode",
        "purpose",
        "single_event",
        "coordinate_space",
        "start_state",
        "end_state",
        "invariants",
        "motion_contract",
        "camera",
        "base",
        "overlays"
