      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "minimum": 1,
          "title": "Scene Id",
          "type": "integer"
        },
        "shot": {
          "discriminator": {
            "mapping": {
              "composite": "#/$defs/CompositeShot",
              "generated": "#/$defs/GeneratedShot",
              "simulation": "#/$defs/SimulationShot",
              "still_motion": "#/$defs/StillMotionShot"
            },
            "propertyName": "render_mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GeneratedShot"
            },
            {
              "$ref": "#/$defs/SimulationShot"
            },
            {
              "$ref": "#/$defs/CompositeShot"
            },
            {
              "$ref": "#/$defs/StillMotionShot"
            }
          ],
          "title": "Shot"
        }
      },
      "required": [
        "scene_id",
        "shot"
      ],
      "title": "AlternateShot",
      "type": "object"
    },
    "AssetRefs": {
