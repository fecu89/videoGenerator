        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "render_mode": {
          "const": "composite",
          "title": "Render Mode",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "single_event": {
          "minLength": 1,
          "title": "Single Event",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntitySpec"
          },
          "title": "Entities",
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/PathSpec"
          },
          "title": "Paths",
          "type": "array"
        },
        "start_state": {
          "$ref": "#/$defs/TimedState"
        },
        "end_state": {
          "$ref": "#/$defs/TimedState"
        },
        "invariants": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Invariants",
          "type": "array"
        },
        "motion_contract": {
          "$ref": "#/$defs/MotionContract"
        },
        "camera": {
          "$ref": "#/$defs/CameraContract"
        },
        "assets": {
          "$ref": "#/$defs/AssetRefs"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/RelationshipSpec"
          },
          "title": "Relationships",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ShotDependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "excluded_elements": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Elements",
          "type": "array"
        },
        "base": {
          "$ref": "#/$defs/CompositeBase"
        },
        "overlays": {
          "items": {
            "$ref": "#/$defs/OverlayContract"
          },
          "minItems": 1,
          "title": "Overlays",
          "type": "array"
        }
