      "type": "integer"
    },
    "simulation_schema": {
      "title": "Simulation Schema",
      "type": "string"
    },
    "graphs": {
      "additionalProperties": {
        "$ref": "#/$defs/RenderSourceSpec"
      },
      "minProperties": 1,
      "title": "Graphs",
      "type": "object"
    }
  },
  "required": [
    "simulation_schema",
    "graphs"
  ],
  "title": "RenderSourceManifest",
  "type": "object"
